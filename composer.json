{
    "name": "wilycode/translation-array",
    "description": "Lazy PHP array translation provider with language fallback, pluralization, and resource mounts.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "wilycode/translation": "^0.1.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "wilycode/translation-languages": "^0.2"
    },
    "autoload": {
        "psr-4": {
            "WilyCode\\TranslationArray\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WilyCode\\TranslationArray\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/examples",
            "/docs",
            "/benchmark",
            "/benchmarks",
            "/tools",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/AGENTS.md",
            "/CHANGELOG.md",
            "/CONTRIBUTING.md",
            "/CODE_OF_CONDUCT.md",
            "/SECURITY.md",
            "/composer.lock",
            "/.github",
            "/.gitignore",
            "/.gitattributes",
            "/.editorconfig",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/phpstan.neon",
            "/phpstan.neon.dist",
            "/phpstan.*.neon",
            "/phpstan.*.neon.dist",
            "/pint.json",
            "/rector.php",
            "/psalm.xml",
            "/psalm.xml.dist",
            "/infection.json",
            "/infection.json.dist"
        ]
    },
    "authors": [
        {
            "name": "Simon Piter"
        }
    ],
    "scripts": {
        "test": "phpunit --configuration phpunit.xml.dist"
    },
    "keywords": [
        "php",
        "translation",
        "i18n",
        "localization",
        "pluralization",
        "array",
        "fallback",
        "wilycode"
    ]
}
